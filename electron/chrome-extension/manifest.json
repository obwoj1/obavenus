{
  "manifest_version": 3,
  "name": "Obavenus Chrome Bridge",
  "version": "1.2.0",
  "description": "Connect signed-in Chrome tabs to Obavenus when you explicitly choose to.",
  "key": "",
  "permissions": ["activeTab", "scripting", "tabs", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "optional_host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Obavenus Chrome Bridge" }
}
