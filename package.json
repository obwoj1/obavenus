{
  "name": "obavenus",
  "productName": "Obavenus",
  "version": "0.1.62",
  "private": true,
  "description": "Obavenus, a local-first Electron desktop assistant.",
  "author": "Obavenus",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "electron .",
    "test": "node --test test/*.test.cjs",
    "prepack:mac": "npm run build --workspace=@siwc/local",
    "predist:mac": "npm run build --workspace=@siwc/local",
    "pack:mac": "electron-builder --dir --mac --arm64",
    "dist:mac": "electron-builder --mac dmg --arm64"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "typescript": "^7.0.0"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.1.0",
    "@siwc/local": "0.1.0",
    "@tesseract.js-data/eng": "1.0.0",
    "docx": "^9.15.0",
    "exceljs": "^4.4.0",
    "image-size": "2.0.4",
    "jszip": "^3.10.2",
    "pdfjs-dist": "^6.4.299",
    "pptxgenjs": "^4.0.1",
    "tesseract.js": "7.0.0",
    "ws": "^8.22.1"
  },
  "workspaces": [
    "vendor/sign-in-with-chatgpt-devkit/packages/local"
  ],
  "build": {
    "appId": "com.obavenus.desktop",
    "productName": "Obavenus",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "vendor/sign-in-with-chatgpt-devkit/packages/local/dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/tesseract.js/**/*",
      "node_modules/tesseract.js-core/**/*",
      "node_modules/@tesseract.js-data/eng/**/*"
    ],
    "extraResources": [
      {
        "from": "electron/chrome-extension",
        "to": "chrome-extension"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/Obavenus.icns",
      "identity": "-",
      "target": [
        "dmg"
      ]
    }
  },
  "overrides": {
    "image-size": "2.0.4",
    "uuid": "11.1.1"
  }
}
