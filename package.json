{
  "name": "obavenus",
  "productName": "Obavenus",
  "version": "0.1.13",
  "private": true,
  "description": "Obavenus, a local-first Electron desktop assistant.",
  "author": "Obavenus",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "electron .",
    "test": "node --test test/*.test.cjs",
    "prepack:mac": "npm run build --workspace=@siwc/local",
    "predist:mac": "npm run build --workspace=@siwc/local",
    "pack:mac": "electron-builder --dir --mac --arm64",
    "dist:mac": "electron-builder --mac dmg --arm64"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "typescript": "^7.0.0"
  },
  "dependencies": {
    "@siwc/local": "0.1.0",
    "docx": "^9.15.0",
    "exceljs": "^4.4.0",
    "pptxgenjs": "^4.0.1"
  },
  "workspaces": [
    "vendor/sign-in-with-chatgpt-devkit/packages/local"
  ],
  "build": {
    "appId": "com.obavenus.desktop",
    "productName": "Obavenus",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "vendor/sign-in-with-chatgpt-devkit/packages/local/dist/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "target": [
        "dmg"
      ]
    }
  },
  "overrides": {
    "image-size": "2.0.4",
    "uuid": "11.1.1"
  }
}
